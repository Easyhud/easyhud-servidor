# Servidor de partidas de Easy HUD — variables de entorno.
# Copia este fichero a `.env` y rellénalo. Lo que ya esté definido en el
# entorno del proceso manda sobre lo que ponga aquí.
#
# Las opciones "activadas" sólo cuentan si valen exactamente `true`.

# ── Autenticación ────────────────────────────────────────────────────────────

# Secreto HMAC compartido con el servicio de cuentas (el mismo valor en los
# dos). Mínimo 32 caracteres. SIN ÉL EL SERVIDOR NO ARRANCA.
# Para generar uno nuevo: npm run token -- --secreto
# Cambiarlo invalida todos los tokens emitidos.
OVERLAY_TOKEN_SECRET=

# Exigir token también en el `logon` de los overlays (puerto 5200). El panel
# (mando /operador) y el observador lo exigen SIEMPRE.
REQUIRE_OVERLAY_TOKEN=false

# SÓLO DESARROLLO LOCAL: `true` desactiva todas las comprobaciones de token y
# permite arrancar sin OVERLAY_TOKEN_SECRET. El log lo avisa a gritos.
EASY_DEV_SIN_AUTH=false

# ── Transporte ───────────────────────────────────────────────────────────────

# `true` = HTTP plano en los tres puertos (lo normal detrás de un proxy o en
# la red actual). Cualquier otro valor = HTTPS con SERVER_KEY y SERVER_CERT.
INSECURE=true

# Rutas a la clave privada y al certificado PEM (sólo con INSECURE distinto
# de `true`). En Docker, si faltan, se genera un certificado autofirmado.
SERVER_KEY=/app/keys/server.key
SERVER_CERT=/app/keys/server.crt

# Los puertos NO se configuran: son 5100 (ingesta), 5200 (salida) y 5101
# (extras). El cliente deriva el 5200 del 5100.

# ── Partidos ─────────────────────────────────────────────────────────────────

# Tiempos muertos extra por equipo al entrar en prórroga (una vez por mapa,
# sin pasar del máximo configurado). 0 = ninguno.
TIEMPOS_MUERTOS_PRORROGA=1

# Minutos sin envíos tras los que un partido abandonado se destruye.
MINUTOS_INACTIVIDAD=30

# ── Grabaciones (.replay) ────────────────────────────────────────────────────

# `false` desactiva la grabación de partidos.
GRABAR_PARTIDAS=true

# Carpeta de las grabaciones (en Docker, /app/replays, montada como volumen).
CARPETA_GRABACIONES=./replays
